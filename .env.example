# Wonderwise environment variables
#
# The app runs with NONE of these set (file-backed store, open grown-up zone).
# Add them to make data durable and to lock the grown-up zone.

# --- Durable database (Supabase / any Postgres) ---
# When set, the app uses Postgres via Drizzle instead of the local file store.
# Use the POOLED ("Transaction") connection string on serverless (Vercel).
DATABASE_URL=

# --- Lock the grown-up zone (recommended before real use) ---
# Any value turns on the passcode gate for /parent. Leave unset for open dev.
PARENT_PASSCODE=

# ---------------------------------------------------------------------------
# Placeholders for later stages:

# --- Owner-only AI content generation (Content Studio) ---
# Enables the Content Studio (/parent/content). The key is read ONLY by server
# code and never sent to a browser; generation is behind the grown-up gate.
ANTHROPIC_API_KEY=

# Reserved for the future multi-parent model. Today the single household is the
# owner, so the parent passcode gate is what makes generation "owner-only".
OWNER_EMAIL=

# --- Supabase extras (image storage, multi-parent auth) — later ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
