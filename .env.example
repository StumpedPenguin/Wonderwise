# Wonderwise environment variables
#
# Stage 1 (this vertical slice) needs NONE of these to run — it uses a
# file-backed local store so you can play the whole loop with zero setup.
#
# These are placeholders for the next stages, documented here so the path
# is clear:

# --- Owner-only AI content generation (Stage 3) ---
# The Anthropic API key is read ONLY by server code and never sent to a browser.
ANTHROPIC_API_KEY=

# The single account allowed to generate content. Kept out of the codebase.
# Any other signed-in account is refused (403) by the server.
OWNER_EMAIL=

# --- Supabase (Stage 0/2: real Postgres, auth, image storage) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
