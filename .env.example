# Wonderwise environment variables

# --- Durable database (Supabase / any Postgres) ---
# When set, the app uses Postgres via Drizzle instead of the local file store.
# Use the POOLED ("Transaction") connection string on serverless (Vercel).
DATABASE_URL=

# --- Parent accounts (Supabase Auth, magic link) ---
# When BOTH are set, the app requires a signed-in parent (magic-link login) and
# is fully multi-family: each account owns its own family. When unset, the app
# runs open as a single default family (local dev). Find these in Supabase →
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Owner-only AI content generation (Content Studio) ---
# Enables the Content Studio (/parent/content). Read ONLY by server code and
# never sent to a browser; generation is behind the signed-in grown-up.
ANTHROPIC_API_KEY=
